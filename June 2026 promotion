<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>โปรโมชั่น Amway เดือนมิถุนายน–กรกฎาคม</title>
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700;800&family=Kanit:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --green: #2d7a4f;
    --green-light: #4caf78;
    --gold: #e8a820;
    --gold-light: #f5c842;
    --coral: #e8533a;
    --teal: #1a8fa0;
    --pink: #e8547a;
    --bg: #f7f4ef;
    --card: #ffffff;
    --text: #1a1a2e;
    --muted: #6b7280;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Sarabun', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* HERO */
  .hero {
    background: linear-gradient(135deg, #1a2e1a 0%, #2d7a4f 50%, #1a4a6e 100%);
    padding: 48px 20px 60px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -60px; right: -60px;
    width: 240px; height: 240px;
    border-radius: 50%;
    background: rgba(232,168,32,0.15);
  }
  .hero::after {
    content: '';
    position: absolute;
    bottom: -80px; left: -40px;
    width: 200px; height: 200px;
    border-radius: 50%;
    background: rgba(255,255,255,0.05);
  }
  .hero-badge {
    display: inline-block;
    background: var(--gold);
    color: #1a1a00;
    font-family: 'Kanit', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 6px 18px;
    border-radius: 20px;
    margin-bottom: 16px;
  }
  .hero h1 {
    font-family: 'Kanit', sans-serif;
    font-size: clamp(28px, 8vw, 48px);
    font-weight: 800;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 8px;
  }
  .hero h1 span { color: var(--gold-light); }
  .hero-sub {
    color: rgba(255,255,255,0.75);
    font-size: 15px;
    margin-bottom: 28px;
  }
  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .stat {
    text-align: center;
  }
  .stat-num {
    font-family: 'Kanit', sans-serif;
    font-size: 28px;
    font-weight: 800;
    color: var(--gold-light);
    display: block;
  }
  .stat-label {
    font-size: 12px;
    color: rgba(255,255,255,0.6);
  }

  /* NAV TABS */
  .nav-wrap {
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }
  .nav-tabs {
    display: flex;
    overflow-x: auto;
    gap: 0;
    scrollbar-width: none;
    padding: 0 12px;
  }
  .nav-tabs::-webkit-scrollbar { display: none; }
  .tab-btn {
    flex-shrink: 0;
    padding: 14px 16px;
    border: none;
    background: none;
    font-family: 'Sarabun', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
    border-bottom: 3px solid transparent;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .tab-btn.active {
    color: var(--green);
    border-bottom-color: var(--green);
  }
  .tab-btn:hover { color: var(--green); }

  /* CONTENT */
  .content {
    padding: 20px 16px 40px;
    max-width: 480px;
    margin: 0 auto;
  }

  .section { display: none; }
  .section.active { display: block; }

  /* SECTION HEADER */
  .section-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    padding-top: 4px;
  }
  .section-icon {
    width: 40px; height: 40px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }
  .section-title {
    font-family: 'Kanit', sans-serif;
    font-size: 20px;
    font-weight: 700;
  }

  /* PROMO CARD */
  .promo-card {
    background: var(--card);
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 16px;
    box-shadow: 0 2px 16px rgba(0,0,0,0.07);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .promo-card:active { transform: scale(0.98); }

  .card-header {
    padding: 16px 18px 12px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }
  .card-brand {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .card-title {
    font-family: 'Kanit', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
  }
  .discount-badge {
    flex-shrink: 0;
    background: var(--coral);
    color: #fff;
    font-family: 'Kanit', sans-serif;
    font-size: 13px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 10px;
    white-space: nowrap;
  }
  .free-badge {
    background: var(--green);
  }

  .card-body { padding: 0 18px 16px; }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 10px;
  }
  .price-new {
    font-family: 'Kanit', sans-serif;
    font-size: 26px;
    font-weight: 800;
    color: var(--coral);
  }
  .price-old {
    font-size: 13px;
    color: var(--muted);
    text-decoration: line-through;
  }
  .price-unit {
    font-size: 13px;
    color: var(--muted);
  }

  .detail-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .detail-list li {
    font-size: 13px;
    color: #444;
    display: flex;
    align-items: flex-start;
    gap: 6px;
    line-height: 1.4;
  }
  .detail-list li::before {
    content: '·';
    color: var(--green);
    font-size: 18px;
    line-height: 1;
    flex-shrink: 0;
  }

  .card-footer {
    background: #f9f9f9;
    border-top: 1px solid #f0f0f0;
    padding: 10px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .period-tag {
    font-size: 11px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .period-tag::before { content: '📅'; font-size: 12px; }
  .apoint-tag {
    font-size: 11px;
    font-weight: 700;
    color: var(--teal);
    background: rgba(26,143,160,0.1);
    padding: 3px 8px;
    border-radius: 6px;
  }

  /* HIGHLIGHT CARD */
  .highlight-card {
    background: linear-gradient(135deg, var(--green) 0%, #1a4a6e 100%);
    border-radius: 20px;
    padding: 20px;
    margin-bottom: 16px;
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .highlight-card::before {
    content: '';
    position: absolute;
    top: -30px; right: -30px;
    width: 120px; height: 120px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
  }
  .highlight-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--gold-light);
    margin-bottom: 6px;
  }
  .highlight-title {
    font-family: 'Kanit', sans-serif;
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .highlight-price {
    font-family: 'Kanit', sans-serif;
    font-size: 32px;
    font-weight: 800;
    color: var(--gold-light);
  }
  .highlight-price span {
    font-size: 14px;
    color: rgba(255,255,255,0.7);
    font-weight: 400;
  }

  /* FREE GIFT ROW */
  .gift-row {
    background: linear-gradient(90deg, #e8f5ef, #f0fdf4);
    border: 1.5px solid #a7dfbe;
    border-radius: 12px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .gift-icon { font-size: 22px; flex-shrink: 0; }
  .gift-text { font-size: 13px; color: var(--green); font-weight: 600; line-height: 1.3; }

  /* CTA */
  .cta-section {
    background: linear-gradient(135deg, #1a2e1a, #2d7a4f);
    border-radius: 20px;
    padding: 24px 20px;
    text-align: center;
    margin-top: 8px;
    color: #fff;
  }
  .cta-title {
    font-family: 'Kanit', sans-serif;
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .cta-sub { font-size: 14px; color: rgba(255,255,255,0.75); margin-bottom: 18px; }
  .cta-btn {
    display: inline-block;
    background: var(--gold);
    color: #1a1a00;
    font-family: 'Kanit', sans-serif;
    font-size: 15px;
    font-weight: 700;
    padding: 12px 32px;
    border-radius: 50px;
    text-decoration: none;
    border: none;
    cursor: pointer;
  }

  /* ANIMATIONS */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .promo-card, .highlight-card {
    animation: fadeUp 0.4s ease both;
  }
  .promo-card:nth-child(2) { animation-delay: 0.05s; }
  .promo-card:nth-child(3) { animation-delay: 0.1s; }
  .promo-card:nth-child(4) { animation-delay: 0.15s; }
</style>
</head>
